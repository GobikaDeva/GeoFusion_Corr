+    @staticmethod
+    def _placebo_prior(prior: np.ndarray, scan: str, view: int, placebo: dict) -> np.ndarray:
+        """Blur or smooth-noise placebo of G at the cached prior's resolution; the valid
+        mask (prior > 0) is unchanged."""
+        valid = (prior > 0).astype(np.float32)
+        if placebo["type"] == "blur":
+            s = float(placebo["sigma_px"])
+            num = cv2.GaussianBlur(prior * valid, (0, 0), s, borderType=cv2.BORDER_REFLECT)
+            den = cv2.GaussianBlur(valid, (0, 0), s, borderType=cv2.BORDER_REFLECT)
+            return np.where(valid > 0, num / np.maximum(den, 1e-6), 0.0).astype(np.float32)
+        seed = (int(scan.lstrip("scan").split("_")[0]) * 1000 + view) & 0x7FFFFFFF
+        field = np.random.default_rng(seed).standard_normal(prior.shape).astype(np.float32)
+        field = cv2.GaussianBlur(field, (0, 0), float(placebo["corr_px"]), borderType=cv2.BORDER_REFLECT)
+        field *= float(placebo["rel_std"]) / max(float(field.std()), 1e-6)
+        return (prior * (1.0 + field) * valid).astype(np.float32)
